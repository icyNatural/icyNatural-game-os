{
  "name": "icyNatural-game-os",
  "version": "1.0.0",
  "private": true,
  "description": "icyNatural Game OS — experience logging, taste learning, lineage discovery (static site, no build step)",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:ui": "node tests/ui-smoke.js",
    "test:catalog": "node tests/catalog-e2e.js",
    "start": "node tools/serve.mjs",
    "build": "node tools/build-public.mjs",
    "rawg-proxy": "node tools/rawg-proxy.mjs",
    "data:seed": "node tools/build-data.mjs",
    "validate:seed": "node --eval \"const {execFileSync}=require('child_process');const path=require('path');execFileSync(process.execPath,[path.resolve('../branch-schema/scripts/validate.ts'),path.resolve('assets/data/seed-graph.json')],{stdio:'inherit'})\""
  }
}
